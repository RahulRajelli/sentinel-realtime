__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
dist/
build/

# Live-run artefacts. Bundles ARE the asset and are committed deliberately;
# raw simulator logs are machine-specific noise.
r8_run.log
r8_run.err
*.BIN
*.bin
*.ulg

# per-test scratch for the history store (see tests/test_memory.py)
tests/.tmp-memory/
history/
tests/.tmp-migration/
tests/.tmp-manifest/

# Internal operating files. They are the agent handoff state and the working log of what was
# tried, retracted and why -- useful to whoever is building this, noise (and occasionally
# half-retracted claims) to anyone reading the public repo. Kept on disk, out of the remote.
# The published write-ups in docs/ are the outward-facing version of the same material.
HANDOFF.md
START-HERE.md

# Prevalence sweep console log. The verdict files under results/prevalence/ are the record;
# this is just the terminal transcript of the run that produced them.
prevalence_run.log
