__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
dist/
build/

# Live-run artefacts. Bundles ARE the asset and are committed deliberately;
# raw simulator logs are machine-specific noise.
r8_run.log
r8_run.err
*.BIN
*.bin
*.ulg

# per-test scratch for the history store (see tests/test_memory.py)
tests/.tmp-memory/
history/
tests/.tmp-migration/
tests/.tmp-manifest/

# Internal operating files. They are the agent handoff state and the working log of what was
# tried, retracted and why -- useful to whoever is building this, noise (and occasionally
# half-retracted claims) to anyone reading the public repo. Kept on disk, out of the remote.
# The published write-ups in docs/ are the outward-facing version of the same material.
HANDOFF.md
START-HERE.md

# Prevalence sweep console log. The verdict files under results/prevalence/ are the record;
# this is just the terminal transcript of the run that produced them.
prevalence_run.log
prevalence_flash.log
prevalence_gemini37.log
prevalence_gemini25.log

# SITL/probe console transcripts. The bundles and results JSON are the record.
sitl_capture.log
pairc_capture.log
ardupilot_says.log
probe_damping.log

# Raw screen captures the published clip was cut from. sentinel_demo_9x16.mp4 (0.7 MB) is the
# deliverable and is committed; these are 14 MB of unedited grabs that would sit in every clone
# forever, and both are reproducible from scripts/r7_r8_scenarios.py plus the capture commands.
pairc_missionplanner.mp4
pairc_demo_stitched.mp4
