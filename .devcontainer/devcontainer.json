{
  "name": "SentinelAgent Realtime",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  // The detectors live in a sibling repo that is not on PyPI, so the two-clone install is the
  // main thing standing between a curious reader and a working checkout. Codespaces does it for
  // them: open the repo in a browser, wait, and step 3 of QUICKSTART.md is already runnable.
  //
  // `..` is the Codespaces workspace root, so ardupilot-log-analyzer lands as a SIBLING of this
  // repo -- which is what flightdx's path-based import expects. Cloning it inside the repo would
  // install fine and then fail to resolve.
  "postCreateCommand": "bash .devcontainer/setup.sh",

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      }
    }
  },

  // No ports: nothing here serves anything. The whole offline path -- 215 tests and the
  // reproduce command -- runs without a network after setup.
  "forwardPorts": []
}
